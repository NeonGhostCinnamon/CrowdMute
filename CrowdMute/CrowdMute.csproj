<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <Description>Mutes the Ambient Sounds channel when many players are nearby.</Description>
    <PackageProjectUrl>https://github.com/NeonGhostCinnamon/CrowdMute</PackageProjectUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copies the icon next to the DLL and manifest in the build output. -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
