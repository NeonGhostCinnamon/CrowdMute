<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.0.3.0</Version>
    <Description>Mutes the Ambient Sounds channel when many players are nearby, muting the annoying noisy crowds.</Description>
    <PackageProjectUrl>https://github.com/NeonGhostCinnamon/CrowdMute</PackageProjectUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="images\crowdmute_icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>


</Project>
